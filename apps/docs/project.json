{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "prefix": "app",
  "implicitDependencies": [
    "2048",
    "angular-cli",
    "browser-storage",
    "chart",
    "cli",
    "core",
    "cron",
    "csv",
    "curl",
    "data-explorer",
    "encode",
    "files",
    "guid",
    "lang-de",
    "lang-es",
    "lang-fr",
    "lang-it",
    "lang-ja",
    "lang-ko",
    "lang-pt",
    "lang-ro",
    "lang-ru",
    "lang-zh",
    "markdown",
    "minesweeper",
    "password-generator",
    "qr",
    "react-cli",
    "regex",
    "scp",
    "server-jobs",
    "server-logs",
    "snake",
    "speed-test",
    "stopwatch",
    "string",
    "sudoku",
    "tetris",
    "text-to-image",
    "todo",
    "users",
    "vue-cli",
    "wget",
    "wordle",
    "yesno"
  ],
  "targets": {
    "llms": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/build-llms.js"
      },
      "inputs": [
        "{workspaceRoot}/docs/ai/**/*",
        "{workspaceRoot}/tools/build-llms.js"
      ],
      "outputs": [
        "{projectRoot}/src/static/llms.txt",
        "{projectRoot}/src/static/llms-full.txt"
      ],
      "cache": true
    },
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "dependsOn": [
        "^build",
        "llms"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/docs/ai/**/*",
        "{workspaceRoot}/tools/build-llms.js"
      ],
      "options": {
        "outputPath": "dist/docs",
        "index": "apps/docs/src/index.html",
        "main": "apps/docs/src/main.ts",
        "tsConfig": "apps/docs/tsconfig.app.json",
        "inlineStyleLanguage": "sass",
        "assets": [
          "apps/docs/src/favicon.ico",
          "apps/docs/src/assets",
          "apps/docs/src/robots.txt",
          {
            "glob": "qodalis_cli_wasm_bg.wasm",
            "input": "dist/cli/wasm",
            "output": "/assets/wasm"
          },
          {
            "glob": "**/*",
            "input": "node_modules/monaco-editor/min/vs",
            "output": "/assets/monaco/vs"
          },
          {
            "glob": "public-api.d.ts",
            "input": "dist/core",
            "output": "/assets/playground/types/cli-core"
          },
          {
            "glob": "**/*",
            "input": "apps/docs/src/static",
            "output": "/"
          }
        ],
        "styles": [
          "apps/docs/src/styles.sass",
          "packages/angular-cli/src/assets/styles.css",
          "node_modules/prismjs/themes/prism-tomorrow.min.css"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2MB",
              "maximumError": "3MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{workspaceRoot}/dist/docs"
      ]
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "dependsOn": [
        "llms"
      ],
      "options": {
        "port": 4300,
        "proxyConfig": "proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "docs:build:production"
        },
        "development": {
          "buildTarget": "docs:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "docs:build"
      }
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "polyfills": [
          "zone.js",
          "zone.js/testing"
        ],
        "tsConfig": "apps/docs/tsconfig.spec.json",
        "inlineStyleLanguage": "sass",
        "assets": [
          "apps/docs/src/favicon.ico",
          "apps/docs/src/assets"
        ],
        "styles": [
          "apps/docs/src/styles.sass"
        ],
        "scripts": [],
        "browsers": "ChromeHeadless",
        "watch": false
      }
    }
  }
}
