{
  "name": "demo-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/demo-angular/src",
  "prefix": "app",
  "implicitDependencies": [
    "2048",
    "angular-cli",
    "browser-storage",
    "cli",
    "core",
    "curl",
    "data-explorer",
    "encode",
    "files",
    "guid",
    "lang-de",
    "lang-es",
    "lang-fr",
    "lang-it",
    "lang-ja",
    "lang-ko",
    "lang-pt",
    "lang-ro",
    "lang-ru",
    "lang-zh",
    "markdown",
    "minesweeper",
    "password-generator",
    "qr",
    "regex",
    "scp",
    "server-jobs",
    "server-logs",
    "snake",
    "speed-test",
    "string",
    "sudoku",
    "tetris",
    "text-to-image",
    "todo",
    "users",
    "wget",
    "wordle",
    "yesno"
  ],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "options": {
        "outputPath": "dist/demo-angular",
        "index": "apps/demo-angular/src/index.html",
        "main": "apps/demo-angular/src/main.ts",
        "tsConfig": "apps/demo-angular/tsconfig.app.json",
        "inlineStyleLanguage": "sass",
        "assets": [
          {
            "glob": "qodalis.svg",
            "input": "apps/demo-angular/src",
            "output": "/"
          },
          {
            "glob": "qodalis_cli_wasm_bg.wasm",
            "input": "dist/cli/wasm",
            "output": "/assets/wasm"
          }
        ],
        "styles": [
          "apps/demo-angular/src/styles.sass",
          "packages/angular-cli/src/assets/styles.css"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2MB",
              "maximumError": "3MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{workspaceRoot}/dist/demo-angular"
      ]
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "port": 4303,
        "proxyConfig": "proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "demo-angular:build:production"
        },
        "development": {
          "buildTarget": "demo-angular:build:development"
        }
      },
      "defaultConfiguration": "development"
    }
  }
}
